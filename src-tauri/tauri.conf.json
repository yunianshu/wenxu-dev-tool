{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Personnel PLM",
  "version": "1.4.103",
  "identifier": "com.prt.devprojectmanager",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://127.0.0.1:5173",
    "beforeDevCommand": "npm run dev:tauri:renderer",
    "beforeBuildCommand": "npm run build:tauri:renderer"
  },
  "app": {
    "windows": [
      {
        "title": "Personnel PLM",
        "width": 1320,
        "height": 860,
        "minWidth": 1080,
        "minHeight": 700,
        "decorations": false,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": {
      "../backend/": "backend/",
      "../electron/": "electron/",
      "../build/tauri-runtime/node_modules/": "node_modules/",
      "../build/harness-runtime.tar.gz": "harness-runtime.tar.gz",
      "../build/harness-runtime.json": "harness-runtime.json",
      "../build/harness-updater.tar.gz": "harness-updater.tar.gz",
      "../build/harness-updater.json": "harness-updater.json",
      "../build/icon.png": "tray-icon.png",
      "../package.json": "package.json"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
